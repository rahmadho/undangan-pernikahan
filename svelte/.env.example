# ============================================================
#  Environment — SvelteKit + PostgreSQL
#  Salin file ini menjadi .env lalu sesuaikan nilainya.
# ============================================================

# --- Server ---
PORT=3300
# ORIGIN dipakai untuk URL absolut (OG meta, CSRF). Set ke domain produksi.
ORIGIN=http://localhost:3300

# --- Database PostgreSQL ---
# Cara 1 (disarankan): satu connection string.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Cara 2: variabel terpisah.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=undangan
# Schema khusus aplikasi (akan dibuat otomatis bila punya izin CREATE).
PGSCHEMA=wedding
# Server Postgres lokal umumnya tanpa SSL -> set "false" bila koneksi ditolak
# dengan pesan "no encryption". Untuk server publik biasanya WAJIB SSL.
# PGSSL=false
PG_POOL_MAX=10

# --- Owner awal (super admin) ---
# Dipakai saat pertama kali seed. GANTI setelah login pertama.
OWNER_USERNAME=owner
OWNER_PASSWORD=owner123

# --- Unggahan file ---
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=10
IMAGE_MAX_MB=6
