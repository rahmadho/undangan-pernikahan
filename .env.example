# ==========================================================================
#  Salin file ini menjadi ".env" lalu sesuaikan nilainya.
#  Semua variabel OPSIONAL — aplikasi tetap jalan dengan nilai default.
# ==========================================================================

# --- Server ---
PORT=3000
# Jumlah hop reverse proxy di depan app (Render/Railway/Nginx => 1).
# Set 0 bila diakses langsung tanpa proxy.
TRUST_PROXY=1

# --- Database ---
# sqlite (default, paling simpel) | postgres (untuk produksi/skala besar)
DB_CLIENT=sqlite

# Khusus SQLite: lokasi file database. WAJIB berada di volume persisten
# saat deploy (mis. /data/wedding.db). Default: ./data/wedding.db
# DATABASE_PATH=./data/wedding.db

# Khusus Postgres (DB_CLIENT=postgres): connection string penyedia Anda.
# Format: postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=postgres://user:password@localhost:5432/undangan

# Set "false" bila Postgres lokal tanpa SSL (mis. di docker-compose).
# PGSSL=false

# --- Unggahan musik (backsound) ---
# Batas ukuran file audio yang diunggah client, dalam MB (default 10).
# UPLOAD_MAX_MB=10
# Folder penyimpanan file upload. WAJIB di volume persisten saat deploy.
# Default: ./data/uploads
# UPLOAD_DIR=./data/uploads

# --- Kepala (owner) awal ---
# Hanya dipakai untuk MEMBUAT owner bila tabel owners masih kosong
# (saat pertama kali start). Setelah itu diabaikan (ganti via /owner).
# Kalau dikosongkan/sekali-pakai, default lama `owner`/`owner123` yang dipakai.
OWNER_USERNAME=owner
OWNER_PASSWORD=ganti-dengan-sandi-kuat
